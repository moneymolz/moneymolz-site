---
import Base from '../layouts/Base.astro';

import { netWorth, ledgerRows, proof, molzLifeHref, links, topics, instagram, about, photos, startHere, moneyMap } from '../data/site';
import { hasUrl, isPlaceholder, stripPlaceholders, short } from '../lib/format';
import { NetWorthCard } from '../components/NetWorthCard';
import Bento from '../components/Bento.astro';

const goal = { current: Math.round(netWorth.current / 1000), target: Math.round(netWorth.goal / 1000) };

const pct = Math.min(100, Math.round((goal.current / goal.target) * 100));
const toGo = Math.max(0, goal.target - goal.current);
const ticks = Array.from({ length: 7 }, (_, i) => Math.round((goal.target / 6) * i));

const shownLinks = links.filter((l) => !isPlaceholder(l.label));
const aboutText = about
  .map(stripPlaceholders)
  .filter(Boolean);
const aboutPhotos = photos.filter((ph) => ph.src);

// diary layout: first about paragraph becomes the hero lede (with drop cap),
// the rest stays in the about section.
const lede = aboutText[0] ?? '';
const aboutRest = aboutText.slice(1);

---
<Base
  title="moneymolz"
  description="net worth updates, budget breakdowns, and the real numbers behind them." ogImage="/anmol.jpg"
>
    <div class="page">
      <header class="mast">
        <div class="rule thick"></div>
        <div class="mast-row">
          <span class="mast-meta">est. 2021</span>
          <span class="wordmark">moneymolz</span>
          <nav>
            <a href="#about">about</a>
            <a href={instagram}>instagram</a>
          </nav>
        </div>
        <div class="rule"></div>
      </header>

      <section class="hero">
        <div class="hero-text">
          <p class="dateline">the ledger · {netWorth.asOf ? `updated ${netWorth.asOf}` : 'brooklyn, ny'}</p>
          <h1>every dollar, <em class="accent">out loud</em>.</h1>
          {lede && <p class="lede">{lede}</p>}
          <div class="actions">
            <a class="btn-solid" href="#money-map">see the money map</a>
            {hasUrl(molzLifeHref) && <a class="text-link" href={molzLifeHref}>peek at my dashboard</a>}
          </div>
          <p class="proof">since {proof.since} · covered by {proof.press.join(' and ')}</p>
          <ul class="links">
            {shownLinks.map((l) => (
              <li>
                {hasUrl(l.href)
                  ? <a class:list={['link', { primary: l.primary }]} href={l.href}>{l.label}{l.badge && <span class="new-note">{l.badge}</span>}</a>
                  : <span class="link soon">{l.label}<span class="soon-note">coming soon</span></span>}
              </li>
            ))}
          </ul>
        </div>
        <div class="hero-card">
          <NetWorthCard
            client:load
            netWorth={netWorth.current}
            goal={netWorth.goal}
            goalLabel={netWorth.goalLabel}
            monthDelta={netWorth.monthDelta}
            milestones={netWorth.milestones}
            series={netWorth.series}
            asOf={netWorth.asOf}
          />
        </div>
      </section>

      <Bento />

      <section class="goal reveal" aria-labelledby="goal-title">
        <div class="goal-head">
          <h2 id="goal-title">the ledger</h2>
          <span class="goal-date">{netWorth.goalLabel} · by {netWorth.goalDate}</span>
        </div>
        <ul class="ledger">
          <li><span>net worth right now</span><span class="dots" aria-hidden="true"></span><b class="goal-now" data-count={goal.current}>${goal.current}k</b></li>
          <li><span>distance to {short(netWorth.goal)}</span><span class="dots" aria-hidden="true"></span><b>${toGo}k to go</b></li>
          {ledgerRows.map((r) => <li><span>{r.label}</span><span class="dots" aria-hidden="true"></span><b>{r.value}</b></li>)}
        </ul>
        <div
          class="ruler"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax={goal.target}
          aria-valuenow={goal.current}
          aria-valuetext={`$${goal.current}k of $${goal.target}k`}
        >
          <div class="ruler-fill" style={`width:${pct}%`} data-w={pct}></div>
        </div>
        <ol class="ticks" aria-hidden="true">
          {ticks.map((t) => <li>{t === 0 ? '$0' : `${t}k`}</li>)}
        </ol>
      </section>

      {startHere.length > 0 && (
        <section id="start" class="split">
          <div class="split-head">
            <h2>start here</h2>
            <p>new to all this? pick the one that sounds like you.</p>
          </div>
          <ul class="rows">
            {startHere.map((s) => (
              <li>
                {hasUrl(s.href)
                  ? <a class="row" href={s.href}><span class="row-title">{s.prompt}</span><span class="row-note">{s.label}</span></a>
                  : <div class="row soon"><span class="row-title">{s.prompt}</span><span class="row-note">{s.label}</span><span class="row-flag">coming soon</span></div>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {aboutPhotos.length > 0 ? (
        <section id="about" class="about reveal">
          <div class="about-text">
            <h2>about me</h2>
            {aboutRest.map((t) => <p>{t}</p>)}
          </div>
          <div class="about-photos">
            {aboutPhotos.map((ph) => <img class:list={{ wide: ph.wide }} src={ph.src} alt={ph.alt} loading="lazy" />)}
          </div>
        </section>
      ) : (
        <section id="about" class="split reveal">
          <div class="split-head"><h2>about me</h2></div>
          <div class="about-text">
            {aboutRest.map((t) => <p>{t}</p>)}
          </div>
        </section>
      )}

      <section id="money-map" class="mapwrap">
        <div class="kicker reveal">the money map</div>
        <h2 class="reveal">where every paycheck goes</h2>
        <p class="map-updated reveal">updated {moneyMap.updated}</p>
        <div class="map">
          <div class="map-node map-start">
            <span class="map-name">{moneyMap.start.name}</span>
            <span class="map-why">{moneyMap.start.why}</span>
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.firstLabel}</div>
          <div class="map-row">
            {moneyMap.first.map((n) => (
              <div class="map-node">
                <span class="map-name">{n.name}</span>
                <span class="map-why">{n.why}</span>
              </div>
            ))}
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-node map-hub">
            <span class="map-name">{moneyMap.hub.name}</span>
            <span class="map-why">{moneyMap.hub.why}</span>
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.hubLabel}</div>
          <div class="map-row">
            {moneyMap.branches.map((n) => (
              <div class="map-node">
                <span class="map-name">{n.name}</span>
                <span class="map-why">{n.why}</span>
              </div>
            ))}
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.cardsLabel}</div>
          <p class="map-note">{moneyMap.cardsNote}</p>
          <ul class="map-chips">
            {moneyMap.cards.map((c) => <li>{c}</li>)}
          </ul>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.investingLabel}</div>
          <div class="map-row">
            {moneyMap.investing.map((n) => (
              <div class="map-node">
                <span class="map-name">{n.name}</span>
                {n.why && <span class="map-why">{n.why}</span>}
              </div>
            ))}
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.cashbackLabel}</div>
          <div class="map-row">
            {moneyMap.cashback.map((n) => (
              <div class="map-node">
                <span class="map-name">{n.name}</span>
                <span class="map-why">{n.why}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="topics reveal">
        <h2>what i post about</h2>
        <ul>
          {topics.map((t, i) => <li><span class="t-num">{String(i + 1).padStart(2, '0')}</span>{t}</li>)}
        </ul>
      </section>

      <footer class="seen reveal">
        <span class="seen-label">as seen on</span>
        <span class="seen-name">CNBC</span>
        <span class="seen-name">Acorns</span>
        <span class="colophon">set in instrument serif, young serif + figtree · brooklyn, ny</span>
      </footer>
    </div>
    <script>
      import { observeReveals } from '../scripts/reveal';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // scroll reveals + cascades + ruler fill on scroll
      const io = observeReveals((el) => {
        const fill = el.querySelector<HTMLElement>('.ruler-fill');
        if (fill?.dataset.w) fill.style.setProperty('width', fill.dataset.w + '%', 'important');
      });
      document.querySelectorAll('.map, .ledger').forEach((list) => {
        Array.from(list.children).forEach((child, i) => {
          (child as HTMLElement).style.transitionDelay = Math.min(i * 70, 800) + 'ms';
        });
        io.observe(list);
      });

      // goal number counts up when scrolled into view
      const goalNow = document.querySelector<HTMLElement>('.goal-now');
      if (goalNow?.dataset.count) {
        const target = parseInt(goalNow.dataset.count, 10);
        const cio = new IntersectionObserver((entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          cio.disconnect();
          if (reduce) return;
          const dur = 1200;
          let t0: number | null = null;
          const tick = (t: number) => {
            t0 ??= t;
            const p = Math.min(1, (t - t0) / dur);
            goalNow.textContent = '$' + Math.round(target * (1 - Math.pow(1 - p, 3))) + 'k';
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }, { threshold: 0.4 });
        cio.observe(goalNow);
      }
    </script>
</Base>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: rgb(var(--paper));
    color: rgb(var(--ink-soft));
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.55;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
  }
  a { color: rgb(var(--ink)); }
  a:focus-visible { outline: 2px solid rgb(var(--ink)); outline-offset: 3px; border-radius: 4px; }
  h1, h2 { font-family: var(--display); font-weight: 400; color: rgb(var(--ink)); margin: 0; }
  ul, ol { list-style: none; margin: 0; padding: 0; }

  .page { max-width: 1160px; margin: 0 auto; padding: 20px 16px 48px; display: flex; flex-direction: column; gap: 56px; }

  /* masthead */
  .mast { display: flex; flex-direction: column; }
  .rule { height: 1px; background: rgb(var(--ink)); }
  .rule.thick { height: 4px; }
  .mast-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 2px; }
  .mast-meta { font-size: 12px; letter-spacing: 0.22em; color: rgb(var(--ink-soft)); }
  .wordmark { font-family: var(--display); font-size: 22px; color: rgb(var(--ink)); }
  .mast nav { display: flex; gap: 20px; font-size: 15px; font-weight: 500; }
  .mast a { text-decoration: none; min-height: 44px; display: flex; align-items: center; }
  .mast a:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* hero: cover story */
  .hero { display: flex; flex-direction: column; gap: 28px; }
  .dateline { margin: 0; font-size: 12px; letter-spacing: 0.22em; color: rgb(var(--ink-soft)); }
  .hero-text { display: flex; flex-direction: column; gap: 16px; }
  .hero h1 { font-family: var(--font-instrument); font-size: 48px; line-height: 52px; letter-spacing: -0.02em; }
  .hero h1 .accent { font-style: italic; color: rgb(var(--molz)); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 4px; }
  .text-link { font-weight: 600; font-size: 16px; color: rgb(var(--molz)); text-underline-offset: 4px; text-decoration: none; }
  .text-link:hover { text-decoration: underline; }
  .proof { margin: 0; font-size: 14px; color: rgb(var(--ink-soft)); }
  .hero-card { animation: settle 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both; }
  .lede { margin: 0; max-width: 38ch; line-height: 1.65; }
  .lede::first-letter {
    font-family: var(--display); font-size: 54px; float: left;
    line-height: 0.85; padding: 4px 8px 0 0; color: rgb(var(--ink));
  }

  /* links: a list, not a stack of pills */
  .links { margin-top: 12px; border-top: 1px solid rgb(var(--line)); }
  .links li { border-bottom: 1px solid rgb(var(--line)); }
  .link {
    display: flex; align-items: center; min-height: 60px; padding: 0 4px;
    text-decoration: none; font-size: 18px; font-weight: 500;
  }
  a.link:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .link.primary {
    background: rgb(var(--ink)); color: rgb(var(--paper)); border-radius: 10px;
    padding: 0 20px; margin: 10px 0;
  }
  .link.primary:hover { text-decoration: none; background: rgb(var(--ink-soft)); }
  .link.primary:focus-visible { outline-offset: 2px; }
  .link.soon { justify-content: space-between; gap: 16px; color: rgb(var(--ink-soft)); }
  .soon-note { font-size: 14px; font-weight: 400; color: rgb(var(--ink-soft)); white-space: nowrap; }
  .new-note {
    font-size: 13px; font-weight: 500; color: rgb(var(--ink)); background: rgb(var(--molz-tint));
    border-radius: 999px; padding: 3px 12px; margin-left: 14px; white-space: nowrap;
  }

  /* goal ruler: the one loud element */
  .goal { display: flex; flex-direction: column; gap: 10px; padding-top: 24px; border-top: 1px solid rgb(var(--ink)); }
  .goal-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .goal h2 { font-size: 24px; }
  .goal-date { font-size: 15px; color: rgb(var(--ink-soft)); }
  /* the ledger */
  .ledger { margin-top: 4px; }
  .ledger li { display: flex; align-items: baseline; gap: 10px; padding: 10px 2px; font-size: 16px; }
  .ledger li + li { border-top: 1px dotted rgb(var(--line)); }
  .ledger .dots { flex: 1; border-bottom: 1px dotted rgb(var(--ink-soft)); transform: translateY(-4px); }
  .ledger b { font-weight: 500; color: rgb(var(--ink)); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .goal-now { font-family: var(--display); font-size: 40px; line-height: 1; letter-spacing: -0.03em; }
  .ruler {
    position: relative; height: 36px; margin-top: 8px;
    border: 1.5px solid rgb(var(--ink)); border-radius: 6px; overflow: hidden;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(100% / 6 - 1px), rgb(var(--line)) calc(100% / 6 - 1px) calc(100% / 6));
  }
  .ruler-fill {
    height: 100%;
    background: linear-gradient(90deg, rgb(var(--molz-tint)), rgb(var(--sand)));
    border-right: 1.5px solid rgb(var(--ink));
  }
  .ticks { display: flex; justify-content: space-between; font-size: 13px; color: rgb(var(--ink-soft)); }

  /* about */
  .about { display: flex; flex-direction: column; gap: 24px; }
  .about h2, .topics h2 { font-size: 34px; line-height: 1.05; letter-spacing: -0.01em; }
  .about-text { display: flex; flex-direction: column; gap: 16px; }
  .about-text p { margin: 0; max-width: 60ch; line-height: 1.65; }
  .about-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .about-photos img { width: 100%; height: 190px; object-fit: cover; border-radius: 12px; display: block; }
  .about-photos img.wide { grid-column: span 2; }

  /* start here: heading beside divided rows */
  .split { display: flex; flex-direction: column; gap: 20px; }
  .split h2 { font-size: 34px; line-height: 1.05; letter-spacing: -0.01em; }
  .split-head { display: flex; flex-direction: column; gap: 12px; }
  .split-head p { margin: 0; max-width: 36ch; color: rgb(var(--ink-soft)); }
  .rows { border-top: 1px solid rgb(var(--line)); }
  .rows li { border-bottom: 1px solid rgb(var(--line)); }
  .row { display: flex; flex-direction: column; gap: 2px; padding: 14px 4px; text-decoration: none; }
  .row-title { font-size: 18px; font-weight: 500; color: rgb(var(--ink)); }
  a.row:hover .row-title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .row-note { font-size: 15px; color: rgb(var(--ink-soft)); }
  .row-flag { font-size: 13px; color: rgb(var(--ink-soft)); }
  .row.soon .row-title { color: rgb(var(--ink-soft)); }

  /* money map */
  .mapwrap { display: flex; flex-direction: column; gap: 12px; }
  .mapwrap h2 { margin: 0; font-size: 34px; line-height: 1.05; letter-spacing: -0.01em; }
  .map-updated { margin: 0; font-size: 14px; letter-spacing: 0.14em; color: rgb(var(--ink-soft)); }
  .map { display: flex; flex-direction: column; align-items: stretch; margin-top: 12px; }
  .map-node { background: rgb(var(--card)); border: 1px solid rgb(var(--line)); border-radius: 14px; padding: 14px 16px; }
  .map-start { background: linear-gradient(135deg, rgb(var(--molz-tint)), rgb(var(--sand))); border: none; text-align: center; }
  .map-hub { border: 1.5px solid rgb(var(--ink)); }
  .map-name { display: block; font-family: var(--display); font-size: 20px; color: rgb(var(--ink)); }
  .map-why { display: block; margin-top: 4px; font-size: 14px; color: rgb(var(--ink-soft)); }
  .map-link { width: 2px; height: 20px; margin: 0 auto; background: linear-gradient(to bottom, rgb(var(--molz-tint)), rgb(var(--sand))); flex: none; }
  .map-tag { align-self: center; padding: 8px 0 10px; font-size: 14px; letter-spacing: 0.14em; color: rgb(var(--ink-soft)); }
  .map-row { display: grid; gap: 10px; }
  .map-note { margin: 0 0 10px; text-align: center; font-size: 15px; color: rgb(var(--ink-soft)); }
  .map-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .map-chips li { border: 1px solid rgb(var(--line)); background: rgb(var(--card)); border-radius: 999px; padding: 8px 14px; font-size: 15px; color: rgb(var(--ink-soft)); }

  /* motion: entrance, scroll reveals, cascades */
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  @keyframes settle { from { opacity: 0; transform: translateY(22px) scale(0.985); } to { opacity: 1; transform: none; } }
  @keyframes inkwash { from { color: rgb(var(--molz-tint)); } to { color: rgb(var(--ink)); } }
  .mast { animation: rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero-text > * { animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero-text > *:nth-child(2) { animation-delay: 0.1s; }
  .hero-text > *:nth-child(3) { animation-delay: 0.2s; }
  .hero-text > *:nth-child(4) { animation-delay: 0.3s; }
  .hero-text > *:nth-child(n+5) { animation-delay: 0.4s; }
  .lede::first-letter { animation: inkwash 1.4s ease 0.6s both; }

  .js .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .js .reveal.in { opacity: 1; transform: none; }

  .js .map > *, .js .ledger > * { opacity: 0; transform: translateY(14px); transition: opacity 0.5s ease, transform 0.5s ease; }
  .js .map.in > *, .js .ledger.in > * { opacity: 1; transform: none; }
  .js .map > .map-link { transform: scaleY(0); transform-origin: top center; }
  .js .map.in > .map-link { transform: scaleY(1); }
  .js .map.in > .map-node:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(20, 20, 20, 0.08); }

  .js .ruler-fill { width: 0 !important; transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.35s; }

  /* hover micro-interactions */
  a.link::after { content: "\2192"; margin-left: auto; padding-left: 16px; opacity: 0; transform: translateX(-8px); transition: opacity 0.25s ease, transform 0.25s ease; }
  a.link:hover::after { opacity: 1; transform: none; }
  .topics li { transition: transform 0.25s ease; }
  .topics li:hover { transform: translateX(6px); }
  .t-num { transition: color 0.25s ease; }
  .topics li:hover .t-num { color: rgb(var(--ink)); }

  /* peach accents */
  .hl { background: linear-gradient(to top, rgb(var(--molz-tint)) 36%, transparent 36%); }
  .mast a:hover { text-decoration-color: rgb(var(--molz-tint)); text-decoration-thickness: 2px; }
  .link.primary { background: var(--molz-solid); color: #fff; }
  .link.primary:hover { background: var(--molz-solid-hover); }
  .mapwrap .kicker {
    align-self: flex-start; background: rgb(var(--molz-tint)); color: rgb(var(--ink));
    border-radius: 999px; padding: 6px 16px; letter-spacing: 0.18em;
  }
  .map-row .map-node { border-left: 3px solid rgb(var(--molz-tint)); }
  .map-chips li { transition: background 0.25s ease; }
  .map-chips li:hover { background: rgb(var(--molz-tint)); }

  /* topics */
  .topics { display: flex; flex-direction: column; gap: 16px; }
  .topics ul { border-top: 1px solid rgb(var(--line)); }
  .topics li { display: flex; gap: 16px; align-items: baseline; padding: 14px 4px; border-bottom: 1px solid rgb(var(--line)); font-size: 18px; color: rgb(var(--ink)); }
  .t-num { font-size: 13px; color: rgb(var(--ink-soft)); font-variant-numeric: tabular-nums; }

  /* footer */
  .seen { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 24px; padding-top: 24px; border-top: 1px solid rgb(var(--line)); }
  .seen-label { width: 100%; font-size: 15px; font-weight: 400; letter-spacing: 0.14em; color: rgb(var(--ink-soft)); }
  .seen-name { font-family: var(--display); font-size: 24px; color: rgb(var(--ink)); }
  .colophon { width: 100%; font-size: 13px; letter-spacing: 0.06em; color: rgb(var(--ink-soft)); }

  @media (min-width: 900px) {
    .page { padding: 32px 48px 64px; gap: 96px; }

    .hero {
      display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: 72px; align-items: center;
    }
    .hero-text { gap: 20px; padding-bottom: 8px; }
