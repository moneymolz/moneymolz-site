---
import Base from '../layouts/Base.astro';
import {
  ArrowRight, CalendarCheck, ClipboardList, Clock, LayoutDashboard, PenLine, Repeat, ShieldCheck, Target, Video,
} from 'lucide-react';
import { DashboardPeek } from '../components/DashboardPeek';
import { peekData } from '../data/demo';
import { molzLifeHref, siteUpdated } from '../data/site';
import { hasUrl } from '../lib/format';

// ===== EDIT THESE =====
const cal = 'https://cal.com/moneymolz/personal-finance-dashboard';
const price = 75;
const minutes = 60;
const instagram = 'https://instagram.com/moneymolz';

const agenda = [
  { icon: Target, title: 'your money picture', note: 'where you are now, and the one goal that matters most.' },
  { icon: Repeat, title: 'the system', note: 'how i automate everything: 401k before the paycheck, savings buckets, net spend tracking.' },
  { icon: LayoutDashboard, title: 'dashboard walkthrough', note: 'a live tour of my setup: net worth, spend, and the math behind financial independence.' },
  { icon: PenLine, title: 'your version', note: 'we map your dashboard to your accounts and goals, with your real numbers.' },
];

const steps = [
  { icon: CalendarCheck, title: '1. book and pay', note: `$${price} through the booking link. prefer paypal? just ask.` },
  // callout: shown in the shield box
  { icon: ClipboardList, title: '2. fill the prep form', note: 'ranges are fine. never share logins or account numbers.', callout: true },
  { icon: Video, title: '3. meet for 60 minutes', note: 'we build your version live. you leave with a blueprint.' },
];
// ======================

// until molz life ships, the sample below is the only live preview
const dashboardHref = hasUrl(molzLifeHref) ? molzLifeHref : '#sample';
---
<Base
  title="work with me · moneymolz"
  description="a 60-minute 1:1 session to build your personal finance dashboard with anmol."
>
    <div class="page">
      <header class="mast">
        <div class="rule thick"></div>
        <div class="mast-row">
          <span class="mast-meta">est. 2021 · updated {siteUpdated}</span>
          <a class="wordmark" href="/">moneymolz</a>
          <nav>
            <a href="/">home</a>
            <a href={instagram}>instagram</a>
          </nav>
        </div>
        <div class="rule"></div>
      </header>

      <section class="hero" id="hero">
        <div class="hero-text">
          <p class="dateline">1:1 sessions</p>
          <h1>build your <em class="accent">dashboard</em> with me.</h1>
          <p class="lede">a {minutes}-minute working session where we build your personal finance dashboard together, using your real numbers.</p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
            <a class="btn-solid group" href={cal}>
              book your session
              <ArrowRight className="h-4 w-4 transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none" aria-hidden="true" />
            </a>
            <a class="btn-outline" href={dashboardHref}>peek at my dashboard</a>
            <span class="inline-flex items-center gap-1.5 text-sm tabular-nums text-ink-soft">
              <Clock className="h-4 w-4" aria-hidden="true" /> {minutes} minutes · ${price}
            </span>
          </div>
        </div>
      </section>

      <section class="split reveal">
        <div class="split-head">
          <h2>what you get</h2>
          <p>one hour, your numbers, no generic advice.</p>
        </div>
        <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2">
          {agenda.map((a) => (
            <li class="rounded-2xl border border-line bg-card p-6 shadow-[0_1px_2px_rgba(28,25,23,.04)]">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-teal-tint text-teal">
                <a.icon className="h-5 w-5" aria-hidden="true" />
              </span>
              <h3 class="m-0 mt-4 text-lg font-semibold text-ink">{a.title}</h3>
              <p class="m-0 mt-1 text-base text-ink-soft">{a.note}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="sample" class="sample reveal" aria-labelledby="sample-title">
        <div class="split-head">
          <h2 id="sample-title">what you'll walk away with</h2>
          <p>a dashboard like this, built around your numbers.</p>
        </div>
        <DashboardPeek client:visible data={peekData} />
        <p class="m-0 text-sm italic text-ink-soft">sample data from a demo dashboard.</p>
      </section>

      <section class="reveal flex flex-col gap-6" aria-labelledby="how-title">
        <h2 id="how-title" class="section-h2">how it works</h2>
        <ol class="relative m-0 grid list-none gap-8 p-0 md:grid-cols-3 md:gap-6">
          <span aria-hidden="true" class="absolute bottom-4 left-5 top-4 w-px bg-line md:bottom-auto md:left-[calc(100%/6)] md:right-[calc(100%/6)] md:top-5 md:h-px md:w-auto"></span>
          {steps.map((s) => (
            <li class="relative flex gap-4 md:flex-col md:items-center md:text-center">
              <span class="relative grid h-10 w-10 shrink-0 place-items-center rounded-full border border-line bg-card text-teal">
                <s.icon className="h-5 w-5" aria-hidden="true" />
              </span>
              <div class="md:max-w-[30ch]">
                <h3 class="m-0 text-lg font-semibold text-ink">{s.title}</h3>
                {s.callout
                  ? (
                    <p class="m-0 mt-2 flex items-start gap-2 rounded-xl bg-teal-tint px-4 py-3 text-left text-sm text-ink">
                      <ShieldCheck className="mt-0.5 h-4 w-4 shrink-0 text-teal" aria-hidden="true" />
                      <span>{s.note}</span>
                    </p>
                  )
                  : <p class="m-0 mt-1 text-base text-ink-soft">{s.note}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="reveal rounded-2xl border border-molz/30 bg-molz-tint p-6 sm:p-8" aria-labelledby="honest-title">
        <h2 id="honest-title" class="section-h2">the honest bit</h2>
        <p class="m-0 mt-3 max-w-[60ch] text-base leading-7 text-ink">this isn't licensed financial advice. it's me showing you the exact system i use, rebuilt around your numbers. everything you share stays between us.</p>
      </section>

      <section class="reveal cta" id="final-cta">
        <a class="btn-solid group w-full justify-center py-4 text-lg" href={cal}>
          book your session · ${price}
          <ArrowRight className="h-5 w-5 transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none" aria-hidden="true" />
        </a>
      </section>

      <footer class="seen reveal">
        <span class="seen-label">as seen on</span>
        <span class="seen-name">CNBC</span>
        <span class="seen-name">Acorns</span>
      </footer>
    </div>

    <!-- mobile: booking bar once the hero is off screen, hidden again at the final button -->
    <div class="book-bar" data-show="false">
      <span class="inline-flex items-center gap-1.5 text-sm tabular-nums text-ink-soft">
        <Clock className="h-4 w-4" aria-hidden="true" /> {minutes} min · ${price}
      </span>
      <a class="btn-solid px-5 py-2.5 text-sm" href={cal}>book your session</a>
    </div>

    <script>
      import { observeReveals } from '../scripts/reveal';
      observeReveals();

      const bar = document.querySelector<HTMLElement>('.book-bar');
      const hero = document.getElementById('hero');
      const cta = document.getElementById('final-cta');
      if (bar && hero && cta) {
        const seen = { hero: true, cta: false };
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { seen[e.target === hero ? 'hero' : 'cta'] = e.isIntersecting; });
          const show = !seen.hero && !seen.cta;
          bar.dataset.show = String(show);
          bar.inert = !show;
        });
        io.observe(hero);
        io.observe(cta);
        bar.inert = true;
      }
    </script>
</Base>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: rgb(var(--paper));
    color: rgb(var(--ink-soft));
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.55;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
  }
  a { color: rgb(var(--ink)); }
  a:focus-visible { outline: 2px solid rgb(var(--molz)); outline-offset: 3px; border-radius: 4px; }
  h1, h2 { font-family: var(--display); font-weight: 400; color: rgb(var(--ink)); margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; }

  .page { max-width: 1160px; margin: 0 auto; padding: 20px 16px 96px; display: flex; flex-direction: column; gap: 56px; }

  .mast { display: flex; flex-direction: column; animation: rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .rule { height: 1px; background: rgb(var(--ink)); }
  .rule.thick { height: 4px; }
  .mast-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 2px; }
  .mast-meta { font-size: 12px; letter-spacing: 0.22em; color: rgb(var(--ink-soft)); }
  @media (max-width: 599px) {
    .mast-row { flex-wrap: wrap; row-gap: 0; }
    .mast-meta { order: 3; flex-basis: 100%; padding-bottom: 4px; }
  }
  .wordmark { font-family: var(--display); font-size: 22px; color: rgb(var(--ink)); text-decoration: none; }
  .mast nav { display: flex; gap: 20px; font-size: 15px; font-weight: 500; }
  .mast nav a { text-decoration: none; min-height: 44px; display: flex; align-items: center; }
  .mast nav a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgb(var(--molz)); text-decoration-thickness: 2px; }

  .hero { display: flex; flex-direction: column; gap: 28px; }
  .dateline { margin: 0; font-size: 12px; letter-spacing: 0.22em; color: rgb(var(--ink-soft)); }
  .hero-text { display: flex; flex-direction: column; gap: 16px; }
  .hero-text > * { animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero-text > *:nth-child(2) { animation-delay: 0.1s; }
  .hero-text > *:nth-child(3) { animation-delay: 0.2s; }
  .hero-text > *:nth-child(4) { animation-delay: 0.3s; }
  .hero h1 { font-family: var(--font-instrument); font-size: 48px; line-height: 52px; letter-spacing: -0.02em; }
  .hero h1 .accent { font-style: italic; color: rgb(var(--molz)); }
  .lede { margin: 0; max-width: 38ch; line-height: 1.65; }

  .split { display: flex; flex-direction: column; gap: 20px; }
  .split h2, .sample h2, .section-h2 { font-size: 34px; line-height: 1.05; letter-spacing: -0.01em; }
  .split-head { display: flex; flex-direction: column; gap: 12px; }
  .split-head p { margin: 0; max-width: 36ch; color: rgb(var(--ink-soft)); }
  .sample { display: flex; flex-direction: column; gap: 20px; }

  .cta { display: flex; }

  /* mobile booking bar */
  .book-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: rgb(var(--card)); border-top: 1px solid rgb(var(--line));
    box-shadow: 0 -4px 16px rgba(28, 25, 23, 0.06);
    transform: translateY(110%); transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .book-bar[data-show="true"] { transform: none; }

  .seen { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 24px; padding-top: 24px; border-top: 1px solid rgb(var(--line)); }
  .seen-label { width: 100%; font-size: 15px; font-weight: 400; letter-spacing: 0.14em; color: rgb(var(--ink-soft)); }
  .seen-name { font-family: var(--display); font-size: 24px; color: rgb(var(--ink)); }

  @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  .js .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .js .reveal.in { opacity: 1; transform: none; }

  @media (min-width: 768px) {
    .page { padding-bottom: 64px; }
    .book-bar { display: none; }
  }
  @media (min-width: 900px) {
    .page { padding: 32px 48px 64px; gap: 96px; }
    .hero h1 { font-size: 72px; line-height: 76px; }
    .lede { font-size: 19px; }
    .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 72px; align-items: start; }
    .split h2, .sample h2, .section-h2 { font-size: 56px; }
    .split-head p { font-size: 18px; }
    .sample { gap: 28px; }
    .seen { flex-wrap: nowrap; gap: 28px; }
    .seen-label { width: auto; }
    .wordmark { font-size: 26px; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
    .js .reveal { opacity: 1 !important; transform: none !important; }
  }
</style>
