---
import { ArrowRight, LayoutDashboard } from 'lucide-react';
import { bento, netWorth, mapDestinations } from '../data/site';
import { hasUrl, short } from '../lib/format';

const nextMilestone = netWorth.milestones.find((m) => netWorth.current < m) ?? null;
const prevMilestone = [...netWorth.milestones].reverse().find((m) => netWorth.current >= m) ?? 0;
const nextPct = nextMilestone ? Math.round((netWorth.current / nextMilestone) * 100) : 100;


const alloc = bento.investing.allocation.slice(0, 3);
const allocColors = ['bg-molz', 'bg-sky', 'bg-hold'];

// shared tile chrome. tiles with a real href are links; '#' tiles say "coming soon".
const tileBase =
  'group relative flex flex-col justify-between gap-4 rounded-2xl border border-line bg-card p-6 text-ink-soft no-underline shadow-[0_1px_2px_rgba(28,25,23,.04)] transition duration-150 motion-reduce:transition-none';
const linkTile =
  'hover:-translate-y-0.5 hover:border-ink-mute motion-reduce:hover:translate-y-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-molz';
const notSynced = 'text-sm text-ink-soft italic';
---
{/* one tile, rendered as a link when it has somewhere to go */}
<section aria-label="at a glance" class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-12">
  {[
    { key: 'map', href: bento.moneyMap.href, span: 'md:col-span-2 lg:col-span-7 lg:row-span-2' },
    { key: 'life', href: bento.molzLife.href, span: 'lg:col-span-5' },
    { key: 'milestones', href: bento.milestones.href, span: 'lg:col-span-5' },
    { key: 'investing', href: bento.investing.href, span: 'lg:col-span-4' },
    { key: 'travel', href: bento.travel.href, span: 'lg:col-span-4' },
    { key: 'slow', href: bento.slowYears.href, span: 'md:col-span-2 lg:col-span-4' },
  ].map((t) => {
    const linked = hasUrl(t.href);
    const Tag = linked ? 'a' : 'div';
    const tone =
      t.key === 'slow' ? '!bg-molz-tint !border-transparent' : t.key === 'travel' ? '!p-0 overflow-hidden min-h-[240px]' : '';
    return (
      <Tag href={linked ? t.href : undefined} class:list={[tileBase, linked && linkTile, t.span, tone]}>
        {t.key === 'map' && (
          <>
            <div>
              <p class="eyebrow m-0">the money map</p>
              <h3 class="m-0 mt-2 font-serif text-[28px] font-normal leading-[34px] text-ink">where every paycheck goes</h3>
              <p class="m-0 mt-2 text-base">paycheck in, <span class="font-semibold tabular-nums text-ink">{mapDestinations}</span> destinations</p>
            </div>
            <svg viewBox="0 0 320 120" class="mini-flow h-auto w-full max-w-[360px] self-center text-line" aria-hidden="true">
              <path d="M20 60 C 70 60, 90 60, 140 60" />
              <path d="M140 60 C 200 60, 220 18, 290 18" />
              <path d="M140 60 C 200 60, 220 46, 290 46" />
              <path d="M140 60 C 200 60, 220 74, 290 74" />
              <path d="M140 60 C 200 60, 220 102, 290 102" />
              <circle cx="20" cy="60" r="7" class="fill-sand" />
              <circle cx="140" cy="60" r="11" class="fill-molz" />
              {[18, 46, 74, 102].map((y) => <circle cx="292" cy={y} r="6" class="fill-sand" />)}
            </svg>
          </>
        )}

        {t.key === 'life' && (
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="eyebrow m-0">molz life dashboard</p>
              <p class="m-0 mt-2 font-serif text-2xl leading-tight text-ink">a peek at my dashboard</p>
            </div>
            <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-molz-tint text-molz" aria-hidden="true">
              <LayoutDashboard className="h-6 w-6" />
            </span>
          </div>
        )}

        {t.key === 'milestones' && (
          <div>
            <p class="eyebrow m-0">milestones</p>
            {nextMilestone
              ? <p class="m-0 mt-2 text-base">next up: <span class="font-semibold tabular-nums text-ink">{short(nextMilestone)}</span>, <span class="font-semibold tabular-nums text-ink">{nextPct}%</span> there</p>
              : <p class="m-0 mt-2 text-base">every milestone reached</p>}
            <ol class="m-0 mt-4 flex list-none items-center gap-2 p-0" aria-label="milestones">
              {netWorth.milestones.map((m, i) => {
                const reached = netWorth.current >= m;
                const isNext = m === nextMilestone;
                const partial = isNext ? Math.round(((netWorth.current - prevMilestone) / (m - prevMilestone)) * 100) : 0;
                return (
                  <li class="flex flex-1 items-center gap-2">
                    <span class="relative h-2 flex-1 overflow-hidden rounded-full bg-sand" aria-hidden="true">
                      <span class="absolute inset-y-0 left-0 rounded-full bg-molz" style={`width:${reached ? 100 : partial}%`}></span>
                    </span>
                    <span class:list={['text-xs tabular-nums', reached || isNext ? 'font-semibold text-ink' : 'text-ink-soft']}>
                      {short(m)}<span class="sr-only">{reached ? ' reached' : isNext ? ' next' : ''}</span>
                    </span>
                    {i < netWorth.milestones.length - 1 && <span class="sr-only">,</span>}
                  </li>
                );
              })}
            </ol>
          </div>
        )}

        {t.key === 'investing' && (
          <div>
            <p class="eyebrow m-0">investing</p>
            {alloc.length
              ? <p class="m-0 mt-2 text-base"><span class="text-ink">{alloc[0].label}</span>, <span class="font-semibold tabular-nums text-ink">{alloc[0].pct}%</span></p>
              : <p class:list={['m-0 mt-2', notSynced]}>not synced yet</p>}
            <div class="mt-4 flex h-3 overflow-hidden rounded-full bg-sand" aria-hidden="true">
              {alloc.map((a, i) => <span class={allocColors[i]} style={`width:${a.pct}%`}></span>)}
            </div>
            {alloc.length > 0 && (
              <ul class="m-0 mt-3 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 text-xs">
                {alloc.map((a, i) => (
                  <li class="inline-flex items-center gap-1.5">
                    <span class:list={['h-2 w-2 rounded-full', allocColors[i]]} aria-hidden="true"></span>{a.label} <span class="tabular-nums">{a.pct}%</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}

        {t.key === 'travel' && (
          <>
            <img src={bento.travel.photo} alt={bento.travel.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover object-[50%_30%]" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" aria-hidden="true"></div>
            <div class="relative mt-auto p-6 text-white">
              <p class="m-0 text-xs font-semibold tracking-[0.08em] text-white/85">solo travel</p>
              <p class="m-0 mt-1 font-serif text-2xl leading-tight">{bento.travel.latest}</p>
              {bento.travel.next && <p class="m-0 mt-1 text-sm text-white/85">where next: {bento.travel.next}</p>}
            </div>
          </>
        )}

        {t.key === 'slow' && (
          <div>
            <p class="eyebrow m-0">slow years</p>
            {bento.slowYears.note
              ? <p class="m-0 mt-3 font-serif text-xl leading-snug text-ink">{bento.slowYears.note}</p>
              : <p class:list={['m-0 mt-3', notSynced]}>not synced yet</p>}
          </div>
        )}

        {linked
          ? (
            <span class:list={['inline-flex h-8 w-8 items-center justify-center self-end rounded-full transition-transform duration-150 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0', t.key === 'travel' ? 'absolute bottom-5 right-5 bg-white/90 text-ink' : 'bg-sand text-ink']} aria-hidden="true">
              <ArrowRight className="h-4 w-4" />
            </span>
          )
          : <span class:list={['self-end text-xs', t.key === 'travel' ? 'absolute right-5 top-5 rounded-full bg-black/45 px-2.5 py-1 text-white' : 'text-ink-soft']}>coming soon</span>}
      </Tag>
    );
  })}
</section>

<style>
  .mini-flow path { fill: none; stroke: currentColor; stroke-width: 2; stroke-dasharray: 220; stroke-dashoffset: 0; }
  .group:hover .mini-flow path { color: rgb(var(--molz)); animation: draw 700ms cubic-bezier(.22, 1, .36, 1) both; }
  @keyframes draw { from { stroke-dashoffset: 220; } to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .group:hover .mini-flow path { animation: none; }
  }
</style>
