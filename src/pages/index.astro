---
// ===== EDIT THESE =====
const links = [
  { label: 'latest net worth update', href: '#', primary: true },
  { label: 'join the newsletter', href: '#' },
  { label: 'molz life (my money dashboard)', href: '#' },
  { label: '[YOUR LINK]', href: '#' },
];

const goal = { title: '300k nw by 30', current: 270, target: 300, date: 'feb 3' };
const topics = ['net worth updates', '401k and hsa', 'index funds', 'budgeting', 'solo travel'];
const instagram = 'https://instagram.com/moneymolz';
// ======================

const pct = Math.round((goal.current / goal.target) * 100);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>moneymolz</title>
    <meta name="description" content="net worth updates, budget breakdowns, and the real numbers behind them." />
    <meta property="og:title" content="moneymolz" />
    <meta property="og:description" content="net worth updates, budget breakdowns, and the real numbers behind them." />
    <meta property="og:image" content="/anmol.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=PT+Serif:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <header class="nav">
        <span class="logo">moneymolz</span>
        <nav>
          <a href="#about">about</a>
          <a href={instagram}>instagram</a>
        </nav>
      </header>

      <section class="hero">
        <div class="hero-text">
          <h1 class="hero-title-desktop">the real numbers behind the money.</h1>
          <h1 class="hero-title-mobile">moneymolz</h1>
          <p>net worth updates, budget breakdowns, and the real numbers behind them.</p>
        </div>
        <img class="hero-photo" src="/anmol.jpg" alt="Anmol smiling on a dock" width="538" height="832" />
      </section>

      <section class="links-row">
        <div class="links">
          {links.map((l) => (
            <a class:list={['pill', { primary: l.primary }]} href={l.href}>{l.label}</a>
          ))}
        </div>
        <div class="card">
          <div class="card-top">
            <span class="card-title">{goal.title}</span>
            <span class="date"><i class="dot"></i>{goal.date}</span>
          </div>
          <div class="track"><div class="fill" style={`width:${pct}%`}></div></div>
          <div class="card-bottom">
            <strong>${goal.current}k</strong>
            <span>${goal.target}k</span>
          </div>
        </div>
      </section>

      <section id="about" class="about">
        <div class="about-text">
          <h2>about me</h2>
          <p>hi, i'm anmol. i've been posting about money on here since 2021, sharing my real numbers: net worth updates, what i'm investing in, and yes, the slow years too.</p>
          <p>[ADD: why you started moneymolz, in your own words]</p>
          <p>i'm based in brooklyn and work in tech. [ADD: something you love outside of money]</p>
        </div>
        <div class="about-photos">
          <!-- Replace these placeholders with real photos: put files in /public and use <img src="/yourfile.jpg" alt="..." /> -->
          <div class="ph tan">[PHOTO: you doing something you love]</div>
          <div class="ph teal">[PHOTO: a trip or a favorite place]</div>
          <div class="ph lilac wide">[PHOTO: wide shot, friends or your setup]</div>
        </div>
      </section>

      <section class="topics">
        <h2>what i post about</h2>
        <div class="chips">
          {topics.map((t) => <span class="chip">{t}</span>)}
        </div>
      </section>

      <footer class="seen">
        <span class="seen-label">as seen on</span>
        <span class="seen-name">CNBC</span>
        <span class="seen-name">Acorns</span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f1ec;
    --ink: #141414;
    --muted: #3a3833;
    --soft: #7b7565;
    --tan: #e3dccb;
    --accent: #ff8c4a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', system-ui, sans-serif;
  }
  a { color: var(--ink); }
  h1, h2, .logo, .card-title, .seen-name, .card-bottom strong {
    font-family: 'PT Serif', Georgia, serif;
    font-weight: 400;
  }

  .page { max-width: 1280px; margin: 0 auto; padding: 40px 28px; display: flex; flex-direction: column; gap: 40px; }

  .nav { display: none; }
  .hero { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
  .hero-photo { order: -1; width: 100%; height: 400px; object-fit: cover; object-position: 50% 25%; border-radius: 200px 200px 24px 24px; }
  .hero-text { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .hero-title-desktop { display: none; }
  .hero-title-mobile { margin: 0; font-size: 46px; line-height: 1; letter-spacing: -0.5px; }
  .hero-text p { margin: 0; font-size: 16px; line-height: 1.5; color: var(--muted); max-width: 290px; }

  .links-row { display: flex; flex-direction: column; gap: 40px; }
  .links { display: flex; flex-direction: column; gap: 12px; }
  .pill {
    display: flex; align-items: center; justify-content: center;
    min-height: 54px; padding: 0 20px; border-radius: 27px;
    background: var(--tan); text-decoration: none; font-weight: 500; font-size: 16px;
    transition: transform 0.15s ease;
  }
  .pill:hover { transform: translateY(-2px); }
  .pill.primary { background: var(--ink); color: var(--bg); }

  .card { background: #fff; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 14px; }
  .card-top { display: flex; align-items: center; justify-content: space-between; }
  .card-title { font-size: 22px; }
  .date { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); }
  .dot { display: block; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .track { height: 20px; border-radius: 10px; background: var(--tan); }
  .fill { height: 100%; border-radius: 10px; background: var(--ink); }
  .card-bottom { display: flex; justify-content: space-between; color: var(--soft); font-size: 16px; }
  .card-bottom strong { font-weight: 700; font-size: 18px; color: var(--ink); }

  .about { display: flex; flex-direction: column; gap: 20px; }
  .about h2, .topics h2 { margin: 0; font-size: 36px; line-height: 1; }
  .about-text { display: flex; flex-direction: column; gap: 20px; }
  .about-text p { margin: 0; font-size: 16px; line-height: 1.65; color: var(--muted); }
  .about-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .ph { height: 200px; border-radius: 16px; display: flex; align-items: center; justify-content: center; text-align: center; padding: 12px; font-size: 13px; }
  .ph.tan { background: #e3dccb; color: #5c5749; }
  .ph.teal { background: #d5e6e6; color: #3d5254; }
  .ph.lilac { background: #f0dcf2; color: #5f4a63; display: none; }

  .topics { display: flex; flex-direction: column; gap: 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { padding: 10px 16px; border-radius: 22px; background: #fff; font-size: 15px; }

  .seen { display: flex; align-items: center; justify-content: center; gap: 26px; margin-top: auto; flex-wrap: wrap; }
  .seen-label { font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--soft); width: 100%; text-align: center; }
  .seen-name { font-size: 24px; }

  @media (min-width: 900px) {
    .page { padding: 48px 96px 56px; gap: 72px; }
    .nav { display: flex; align-items: center; justify-content: space-between; }
    .logo { font-size: 26px; }
    .nav nav { display: flex; gap: 28px; font-size: 15px; font-weight: 500; }
    .nav a { text-decoration: none; display: flex; align-items: center; min-height: 44px; }

    .hero { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 96px; align-items: center; text-align: left; }
    .hero-photo { order: 0; height: 620px; border-radius: 320px 320px 28px 28px; }
    .hero-text { align-items: flex-start; gap: 28px; }
    .hero-title-mobile { display: none; }
    .hero-title-desktop { display: block; margin: 0; font-size: 84px; line-height: 1.02; letter-spacing: -1.5px; }
    .hero-text p { font-size: 19px; line-height: 1.55; max-width: 460px; }

    .links-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 96px; align-items: start; }
    .pill { min-height: 58px; font-size: 17px; border-radius: 29px; }
    .card { padding: 28px; border-radius: 22px; gap: 18px; }
    .card-title { font-size: 28px; }
    .date { font-size: 14px; }
    .track { height: 22px; border-radius: 11px; }
    .card-bottom { font-size: 18px; }
    .card-bottom strong { font-size: 20px; }

    .about { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 96px; align-items: start; }
    .about h2 { font-size: 56px; }
    .about-text { gap: 22px; }
    .about-text p { font-size: 18px; line-height: 1.7; max-width: 480px; }
    .about-photos { gap: 16px; }
    .ph { height: 300px; border-radius: 20px; font-size: 14px; }
    .ph.lilac { display: flex; grid-column: span 2; height: 240px; }

    .topics h2 { font-size: 40px; }
    .chips { gap: 12px; }
    .chip { padding: 12px 20px; border-radius: 24px; font-size: 16px; }

    .seen { justify-content: flex-start; gap: 28px; flex-wrap: nowrap; }
    .seen-label { width: auto; text-align: left; }
  }
</style>
