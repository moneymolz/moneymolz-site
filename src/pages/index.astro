---
import Analytics from '@vercel/analytics/astro';

// ===== EDIT THESE =====
const links = [
  { label: 'latest net worth update', href: '#', primary: true },
  { label: 'join the newsletter', href: '#' },
  { label: 'molz life: a peek at my dashboard', href: '#' },
  { label: '[YOUR LINK]', href: '#' },
];

// current and target are in $k. date shows as "by feb 3".
const goal = { title: '300k by 30', current: 270, target: 300, date: 'feb 3' };
const topics = ['net worth updates', '401k and hsa', 'index funds', 'budgeting', 'solo travel'];
const instagram = 'https://instagram.com/moneymolz';

// about me. anything in [BRACKETS] is hidden until you replace it,
// and a paragraph that's only a placeholder is left out.
const about = [
  "hi, i'm anmol. i've been posting about money on here since 2021, sharing my real numbers: net worth updates, what i'm investing in, and yes, the slow years too.",
  '[ADD: why you started moneymolz, in your own words]',
  "i'm based in brooklyn and work in tech. [ADD: something you love outside of money]",
];

// about photos: put files in /public, then set src like '/trip.jpg'. empty src = hidden.
// with no photos, the about section switches to a text-only layout.
const photos = [
  { src: '', alt: 'you doing something you love' },
  { src: '', alt: 'a trip or a favorite place' },
  { src: '', alt: 'wide shot, friends or your setup', wide: true },
];

// "start here" stays hidden until you add at least one path.
// example: { prompt: "i just got my first 401k", label: 'watch my 401k basics reel', href: 'https://...' },
const startHere = [];

// the money map: where every paycheck goes. names + one-line whys, no balances, no account numbers.
// slide 2 of the moneymap post, as a living section. update names/whys here; the page redraws.
const moneyMap = {
  updated: 'september 2026',
  start: { name: 'paycheck', why: 'lands every 15th and end of month' },
  firstLabel: 'first',
  first: [
    { name: '401k - cresta plan (fidelity)', why: 'retirement first. maxing it out' },
    { name: 'hsa', why: 'maxed' },
  ],
  hub: { name: 'robinhood checking', why: 'the hub. bills and rent flow out of here' },
  hubLabel: 'from the hub',
  branches: [
    { name: 'robinhood savings', why: 'travel + gift buckets' },
    { name: 'fidelity brokerage', why: 'emergency fund + wedding bucket, in SGOV' },
  ],
  cardsLabel: 'credit cards',
  cardsNote: 'all on autopay, paid off manually every payday',
  cards: [
    'chase sapphire preferred',
    'chase freedom unlimited',
    'united explorer card',
    'world of hyatt credit card',
    'bilt blue',
    'u.s. bank altitude connect',
    'robinhood credit card',
  ],
  investingLabel: 'investing',
  investing: [
    { name: 'robinhood traditional ira', why: '' },
    { name: 'robinhood roth ira', why: '' },
    { name: 'ny 529', why: '' },
  ],
  cashbackLabel: 'cashback apps',
  cashback: [
    { name: 'rakuten', why: 'cash back on stuff i\u2019d buy anyway' },
    { name: 'fetch', why: 'points for snapping receipts' },
  ],
};
// ======================

const pct = Math.min(100, Math.round((goal.current / goal.target) * 100));
const toGo = Math.max(0, goal.target - goal.current);
const ticks = Array.from({ length: 7 }, (_, i) => Math.round((goal.target / 6) * i));

// a link with href '' or '#' shows as "coming soon" instead of a dead link.
// anything still named like '[PLACEHOLDER]' is left off the page entirely.
const hasUrl = (href) => Boolean(href) && href !== '#';
const isPlaceholder = (text) => text.trim().startsWith('[');
const stripPlaceholders = (text = '') => text.replace(/\[[^\]]*\]/g, '').replace(/\s+/g, ' ').trim();
const shownLinks = links.filter((l) => !isPlaceholder(l.label));
const aboutText = about
  .map(stripPlaceholders)
  .filter(Boolean);
const aboutPhotos = photos.filter((ph) => ph.src);

// diary layout: first about paragraph becomes the hero lede (with drop cap),
// the rest stays in the about section.
const lede = aboutText[0] ?? '';
const aboutRest = aboutText.slice(1);

// build-time dateline, e.g. "september 2026". refreshes on every deploy.
const buildDate = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' }).toLowerCase();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>moneymolz</title>
    <meta name="description" content="net worth updates, budget breakdowns, and the real numbers behind them." />
    <meta property="og:title" content="moneymolz" />
    <meta property="og:description" content="net worth updates, budget breakdowns, and the real numbers behind them." />
    <script>document.documentElement.classList.add('js');</script>
    <meta property="og:image" content="/anmol.jpg" />
    <meta name="theme-color" content="#F6F1EE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Figtree:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <div class="page">
      <header class="mast">
        <div class="rule thick"></div>
        <div class="mast-row">
          <span class="mast-meta">est. 2021</span>
          <span class="wordmark">moneymolz</span>
          <nav>
            <a href="#about">about</a>
            <a href={instagram}>instagram</a>
          </nav>
        </div>
        <div class="rule"></div>
      </header>

      <section class="hero">
        <div class="hero-text">
          <p class="dateline">{buildDate} · brooklyn, ny</p>
          <h1>the <span class="hl">real numbers</span> behind the money.</h1>
          {lede && <p class="lede">{lede}</p>}
          <ul class="links">
            {shownLinks.map((l) => (
              <li>
                {hasUrl(l.href)
                  ? <a class:list={['link', { primary: l.primary }]} href={l.href}>{l.label}</a>
                  : <span class="link soon">{l.label}<span class="soon-note">coming soon</span></span>}
              </li>
            ))}
          </ul>
        </div>
        <figure class="hero-fig">
          <img class="hero-photo" src="/anmol.jpg" alt="Anmol on a balcony in Dubrovnik at sunset" width="1200" height="1600" />
          <figcaption>dubrovnik, july 2026.</figcaption>
        </figure>
      </section>

      <section class="goal reveal" aria-labelledby="goal-title">
        <div class="goal-head">
          <h2 id="goal-title">the ledger</h2>
          <span class="goal-date">{goal.title} · by {goal.date}</span>
        </div>
        <ul class="ledger">
          <li><span>net worth right now</span><span class="dots" aria-hidden="true"></span><b class="goal-now" data-count={goal.current}>${goal.current}k</b></li>
          <li><span>distance to 300k</span><span class="dots" aria-hidden="true"></span><b>${toGo}k to go</b></li>
          <li><span>401k per paycheck</span><span class="dots" aria-hidden="true"></span><b>26%</b></li>
        </ul>
        <div
          class="ruler"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax={goal.target}
          aria-valuenow={goal.current}
          aria-valuetext={`$${goal.current}k of $${goal.target}k`}
        >
          <div class="ruler-fill" style={`width:${pct}%`} data-w={pct}></div>
        </div>
        <ol class="ticks" aria-hidden="true">
          {ticks.map((t) => <li>{t === 0 ? '$0' : `${t}k`}</li>)}
        </ol>
      </section>

      {startHere.length > 0 && (
        <section id="start" class="split">
          <div class="split-head">
            <h2>start here</h2>
            <p>new to all this? pick the one that sounds like you.</p>
          </div>
          <ul class="rows">
            {startHere.map((s) => (
              <li>
                {hasUrl(s.href)
                  ? <a class="row" href={s.href}><span class="row-title">{s.prompt}</span><span class="row-note">{s.label}</span></a>
                  : <div class="row soon"><span class="row-title">{s.prompt}</span><span class="row-note">{s.label}</span><span class="row-flag">coming soon</span></div>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {aboutPhotos.length > 0 ? (
        <section id="about" class="about reveal">
          <div class="about-text">
            <h2>about me</h2>
            {aboutRest.map((t) => <p>{t}</p>)}
          </div>
          <div class="about-photos">
            {aboutPhotos.map((ph) => <img class:list={{ wide: ph.wide }} src={ph.src} alt={ph.alt} loading="lazy" />)}
          </div>
        </section>
      ) : (
        <section id="about" class="split reveal">
          <div class="split-head"><h2>about me</h2></div>
          <div class="about-text">
            {aboutRest.map((t) => <p>{t}</p>)}
          </div>
        </section>
      )}

      <section id="money-map" class="mapwrap">
        <div class="kicker reveal">the money map</div>
        <h2 class="reveal">where every paycheck goes</h2>
        <p class="map-updated reveal">updated {moneyMap.updated}</p>
        <div class="map">
          <div class="map-node map-start">
            <span class="map-name">{moneyMap.start.name}</span>
            <span class="map-why">{moneyMap.start.why}</span>
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.firstLabel}</div>
          <div class="map-row">
            {moneyMap.first.map((n) => (
              <div class="map-node">
                <span class="map-name">{n.name}</span>
                <span class="map-why">{n.why}</span>
              </div>
            ))}
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-node map-hub">
            <span class="map-name">{moneyMap.hub.name}</span>
            <span class="map-why">{moneyMap.hub.why}</span>
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.hubLabel}</div>
          <div class="map-row">
            {moneyMap.branches.map((n) => (
              <div class="map-node">
                <span class="map-name">{n.name}</span>
                <span class="map-why">{n.why}</span>
              </div>
            ))}
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.cardsLabel}</div>
          <p class="map-note">{moneyMap.cardsNote}</p>
          <ul class="map-chips">
            {moneyMap.cards.map((c) => <li>{c}</li>)}
          </ul>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.investingLabel}</div>
          <div class="map-row">
            {moneyMap.investing.map((n) => (
              <div class="map-node">
                <span class="map-name">{n.name}</span>
                {n.why && <span class="map-why">{n.why}</span>}
              </div>
            ))}
          </div>
          <div class="map-link" aria-hidden="true"></div>
          <div class="map-tag">{moneyMap.cashbackLabel}</div>
          <div class="map-row">
            {moneyMap.cashback.map((n) => (
              <div class="map-node">
                <span class="map-name">{n.name}</span>
                <span class="map-why">{n.why}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="topics reveal">
        <h2>what i post about</h2>
        <ul>
          {topics.map((t, i) => <li><span class="t-num">{String(i + 1).padStart(2, '0')}</span>{t}</li>)}
        </ul>
      </section>

      <footer class="seen reveal">
        <span class="seen-label">as seen on</span>
        <span class="seen-name">CNBC</span>
        <span class="seen-name">Acorns</span>
        <span class="colophon">set in young serif + figtree · brooklyn, ny</span>
      </footer>
    </div>
    <script>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // scroll reveals + cascades + ruler fill on scroll
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              var fill = e.target.querySelector('.ruler-fill');
              if (fill && fill.dataset.w) {
                fill.style.setProperty('width', fill.dataset.w + '%', 'important');
              }
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
        document.querySelectorAll('.map, .ledger').forEach(function (list) {
          Array.prototype.forEach.call(list.children, function (child, i) {
            child.style.transitionDelay = Math.min(i * 70, 800) + 'ms';
          });
          io.observe(list);
        });

        // goal number counts up when scrolled into view
        var goalNow = document.querySelector('.goal-now');
        if (goalNow && goalNow.dataset.count) {
          var counted = false;
          var cio = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting || counted) return;
              counted = true;
              cio.unobserve(e.target);
              if (reduce) return;
              var target = parseInt(goalNow.dataset.count, 10);
              var dur = 1200, t0 = null;
              requestAnimationFrame(function tick(t) {
                if (!t0) t0 = t;
                var p = Math.min(1, (t - t0) / dur);
                var eased = 1 - Math.pow(1 - p, 3);
                goalNow.textContent = '$' + Math.round(target * eased) + 'k';
                if (p < 1) requestAnimationFrame(tick);
              });
            });
          }, { threshold: 0.4 });
          cio.observe(goalNow);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --cream: #F6F1EE;
    --ink: #141414;
    --body: #3A372F;
    --muted: #6B6455;
    --divider: #E3DCCD;
    --kicker: #8A8172;
    --peach: #F2DBBC;
    --mint: #CFE3E1;

    --display: 'Young Serif', Georgia, serif;
    --sans: 'Figtree', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--cream);
    color: var(--body);
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.55;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--ink); }
  a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 4px; }
  h1, h2 { font-family: var(--display); font-weight: 400; color: var(--ink); margin: 0; }
  ul, ol { list-style: none; margin: 0; padding: 0; }

  .page { max-width: 1160px; margin: 0 auto; padding: 20px 16px 48px; display: flex; flex-direction: column; gap: 56px; }

  /* masthead */
  .mast { display: flex; flex-direction: column; }
  .rule { height: 1px; background: var(--ink); }
  .rule.thick { height: 4px; }
  .mast-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 2px; }
  .mast-meta { font-size: 12px; letter-spacing: 0.22em; color: var(--kicker); }
  .wordmark { font-family: var(--display); font-size: 22px; color: var(--ink); }
  .mast nav { display: flex; gap: 20px; font-size: 15px; font-weight: 500; }
  .mast a { text-decoration: none; min-height: 44px; display: flex; align-items: center; }
  .mast a:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* hero: cover story */
  .hero { display: flex; flex-direction: column; gap: 28px; }
  .dateline { margin: 0; font-size: 12px; letter-spacing: 0.22em; color: var(--kicker); }
  .hero-text { display: flex; flex-direction: column; gap: 16px; }
  .hero h1 { font-size: 44px; line-height: 1.02; letter-spacing: -0.02em; }
  .lede { margin: 0; max-width: 38ch; line-height: 1.65; }
  .lede::first-letter {
    font-family: var(--display); font-size: 54px; float: left;
    line-height: 0.85; padding: 4px 8px 0 0; color: var(--ink);
  }
  .hero-fig { margin: 0; background: #fff; border: 1px solid var(--ink); padding: 10px 10px 6px; border-radius: 4px; }
  .hero-photo { width: 100%; height: 360px; object-fit: cover; object-position: 50% 30%; display: block; }
  .hero-fig figcaption { font-size: 13px; font-style: italic; color: var(--muted); padding: 8px 2px 2px; }

  /* links: a list, not a stack of pills */
  .links { margin-top: 12px; border-top: 1px solid var(--divider); }
  .links li { border-bottom: 1px solid var(--divider); }
  .link {
    display: flex; align-items: center; min-height: 60px; padding: 0 4px;
    text-decoration: none; font-size: 18px; font-weight: 500;
  }
  a.link:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .link.primary {
    background: var(--ink); color: var(--cream); border-radius: 10px;
    padding: 0 20px; margin: 10px 0;
  }
  .link.primary:hover { text-decoration: none; background: var(--body); }
  .link.primary:focus-visible { outline-offset: 2px; }
  .link.soon { justify-content: space-between; gap: 16px; color: var(--muted); }
  .soon-note { font-size: 14px; font-weight: 400; color: var(--kicker); white-space: nowrap; }

  /* goal ruler: the one loud element */
  .goal { display: flex; flex-direction: column; gap: 10px; padding-top: 24px; border-top: 1px solid var(--ink); }
  .goal-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .goal h2 { font-size: 24px; }
  .goal-date { font-size: 15px; color: var(--muted); }
  /* the ledger */
  .ledger { margin-top: 4px; }
  .ledger li { display: flex; align-items: baseline; gap: 10px; padding: 10px 2px; font-size: 16px; }
  .ledger li + li { border-top: 1px dotted var(--divider); }
  .ledger .dots { flex: 1; border-bottom: 1px dotted var(--muted); transform: translateY(-4px); }
  .ledger b { font-weight: 500; color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .goal-now { font-family: var(--display); font-size: 40px; line-height: 1; letter-spacing: -0.03em; }
  .ruler {
    position: relative; height: 36px; margin-top: 8px;
    border: 1.5px solid var(--ink); border-radius: 6px; overflow: hidden;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(100% / 6 - 1px), var(--divider) calc(100% / 6 - 1px) calc(100% / 6));
  }
  .ruler-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--peach), var(--mint));
    border-right: 1.5px solid var(--ink);
  }
  .ticks { display: flex; justify-content: space-between; font-size: 13px; color: var(--kicker); }

  /* about */
  .about { display: flex; flex-direction: column; gap: 24px; }
  .about h2, .topics h2 { font-size: 34px; line-height: 1.05; letter-spacing: -0.01em; }
  .about-text { display: flex; flex-direction: column; gap: 16px; }
  .about-text p { margin: 0; max-width: 60ch; line-height: 1.65; }
  .about-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .about-photos img { width: 100%; height: 190px; object-fit: cover; border-radius: 12px; display: block; }
  .about-photos img.wide { grid-column: span 2; }

  /* start here: heading beside divided rows */
  .split { display: flex; flex-direction: column; gap: 20px; }
  .split h2 { font-size: 34px; line-height: 1.05; letter-spacing: -0.01em; }
  .split-head { display: flex; flex-direction: column; gap: 12px; }
  .split-head p { margin: 0; max-width: 36ch; color: var(--muted); }
  .groups { display: flex; flex-direction: column; gap: 28px; }
  .group h3 { margin: 0 0 8px; font-size: 15px; font-weight: 400; letter-spacing: 0.06em; color: var(--kicker); }
  .rows { border-top: 1px solid var(--divider); }
  .rows li { border-bottom: 1px solid var(--divider); }
  .row { display: flex; flex-direction: column; gap: 2px; padding: 14px 4px; text-decoration: none; }
  .row-title { font-size: 18px; font-weight: 500; color: var(--ink); }
  a.row:hover .row-title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .row-note { font-size: 15px; color: var(--muted); }
  .row-flag { font-size: 13px; color: var(--kicker); }
  .row.soon .row-title { color: var(--body); }

  /* money map */
  .mapwrap { display: flex; flex-direction: column; gap: 12px; }
  .mapwrap h2 { margin: 0; font-size: 34px; line-height: 1.05; letter-spacing: -0.01em; }
  .map-updated { margin: 0; font-size: 14px; letter-spacing: 0.14em; color: var(--kicker); }
  .map { display: flex; flex-direction: column; align-items: stretch; margin-top: 12px; }
  .map-node { background: #fff; border: 1px solid var(--divider); border-radius: 14px; padding: 14px 16px; }
  .map-start { background: linear-gradient(135deg, var(--peach), var(--mint)); border: none; text-align: center; }
  .map-hub { border: 1.5px solid var(--ink); }
  .map-name { display: block; font-family: var(--display); font-size: 20px; color: var(--ink); }
  .map-why { display: block; margin-top: 4px; font-size: 14px; color: var(--muted); }
  .map-link { width: 2px; height: 20px; margin: 0 auto; background: linear-gradient(to bottom, var(--peach), var(--mint)); flex: none; }
  .map-tag { align-self: center; padding: 8px 0 10px; font-size: 14px; letter-spacing: 0.14em; color: var(--kicker); }
  .map-row { display: grid; gap: 10px; }
  .map-note { margin: 0 0 10px; text-align: center; font-size: 15px; color: var(--muted); }
  .map-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .map-chips li { border: 1px solid var(--divider); background: #fff; border-radius: 999px; padding: 8px 14px; font-size: 15px; color: var(--body); }

  /* motion: entrance, scroll reveals, cascades */
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  @keyframes settle { from { opacity: 0; transform: translateY(22px) scale(0.985); } to { opacity: 1; transform: none; } }
  @keyframes inkwash { from { color: var(--peach); } to { color: var(--ink); } }
  .mast { animation: rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero-fig { animation: settle 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both; }
  .hero-text > * { animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero-text > *:nth-child(2) { animation-delay: 0.1s; }
  .hero-text > *:nth-child(3) { animation-delay: 0.2s; }
  .hero-text > *:nth-child(4) { animation-delay: 0.3s; }
