---
import Analytics from '@vercel/analytics/astro';

// ===== EDIT THESE =====
const links = [
  { label: 'latest net worth update', href: '#', primary: true },
  { label: 'join the newsletter', href: '#' },
  { label: 'molz life: a peek at my dashboard', href: '#' },
  { label: '[YOUR LINK]', href: '#' },
];

// current and target are in $k. date shows as "by feb 3".
const goal = { title: '300k by 30', current: 270, target: 300, date: 'feb 3' };
const topics = ['net worth updates', '401k and hsa', 'index funds', 'budgeting', 'solo travel'];
const instagram = 'https://instagram.com/moneymolz';

// about me. anything in [BRACKETS] is hidden until you replace it,
// and a paragraph that's only a placeholder is left out.
const about = [
  "hi, i'm anmol. i've been posting about money on here since 2021, sharing my real numbers: net worth updates, what i'm investing in, and yes, the slow years too.",
  '[ADD: why you started moneymolz, in your own words]',
  "i'm based in brooklyn and work in tech. [ADD: something you love outside of money]",
];

// about photos: put files in /public, then set src like '/trip.jpg'. empty src = hidden.
// with no photos, the about section switches to a text-only layout.
const photos = [
  { src: '', alt: 'you doing something you love' },
  { src: '', alt: 'a trip or a favorite place' },
  { src: '', alt: 'wide shot, friends or your setup', wide: true },
];

// "start here" stays hidden until you add at least one path.
// example: { prompt: "i just got my first 401k", label: 'watch my 401k basics reel', href: 'https://...' },
const startHere = [];

// resources i actually use. set affiliate: true if the link earns you anything; it shows a small note.
// remove a whole group by deleting it, or add new ones (budgeting, taxes, books...).
const resources = [
  {
    group: 'banking',
    items: [
      { name: '[BANK NAME]', why: '[ADD: one line on why you use it]', href: '#', affiliate: false },
      { name: '[HIGH-YIELD SAVINGS]', why: '[ADD: one line on why you use it]', href: '#', affiliate: false },
    ],
  },
  {
    group: 'credit cards',
    items: [
      { name: '[CARD NAME]', why: '[ADD: one line on why you use it]', href: '#', affiliate: false },
    ],
  },
  {
    group: 'investing',
    items: [
      { name: '[BROKERAGE]', why: '[ADD: one line on why you use it]', href: '#', affiliate: false },
      { name: '[HSA PROVIDER]', why: '[ADD: one line on why you use it]', href: '#', affiliate: false },
    ],
  },
];
// ======================

const pct = Math.min(100, Math.round((goal.current / goal.target) * 100));
const toGo = Math.max(0, goal.target - goal.current);
const ticks = Array.from({ length: 7 }, (_, i) => Math.round((goal.target / 6) * i));

// a link with href '' or '#' shows as "coming soon" instead of a dead link.
// anything still named like '[PLACEHOLDER]' is left off the page entirely.
const hasUrl = (href) => Boolean(href) && href !== '#';
const isPlaceholder = (text) => text.trim().startsWith('[');
const stripPlaceholders = (text = '') => text.replace(/\[[^\]]*\]/g, '').replace(/\s+/g, ' ').trim();
const shownLinks = links.filter((l) => !isPlaceholder(l.label));
const shownResources = resources
  .map((g) => ({ ...g, items: g.items.filter((r) => !isPlaceholder(r.name)).map((r) => ({ ...r, why: stripPlaceholders(r.why) })) }))
  .filter((g) => g.items.length > 0);
const aboutText = about
  .map(stripPlaceholders)
  .filter(Boolean);
const aboutPhotos = photos.filter((ph) => ph.src);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>moneymolz</title>
    <meta name="description" content="net worth updates, budget breakdowns, and the real numbers behind them." />
    <meta property="og:title" content="moneymolz" />
    <meta property="og:description" content="net worth updates, budget breakdowns, and the real numbers behind them." />
    <meta property="og:image" content="/anmol.jpg" />
    <meta name="theme-color" content="#F6F1EE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=PT+Serif:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <div class="page">
      <header class="top">
        <span class="kicker">moneymolz</span>
        <nav>
          <a href="#about">about</a>
          <a href={instagram}>instagram</a>
        </nav>
      </header>

      <section class="hero">
        <img class="hero-photo" src="/anmol.jpg" alt="Anmol smiling on a dock" width="538" height="832" />
        <div class="hero-text">
          <h1>the real numbers behind the money.</h1>
          <p>net worth updates, budget breakdowns, and the real numbers behind them.</p>
          <ul class="links">
            {shownLinks.map((l) => (
              <li>
                {hasUrl(l.href)
                  ? <a class:list={['link', { primary: l.primary }]} href={l.href}>{l.label}</a>
                  : <span class="link soon">{l.label}<span class="soon-note">coming soon</span></span>}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="goal" aria-labelledby="goal-title">
        <div class="goal-head">
          <h2 id="goal-title">{goal.title}</h2>
          <span class="goal-date">by {goal.date}</span>
        </div>
        <div class="goal-figures">
          <span class="goal-now">${goal.current}k</span>
          <span class="goal-left">${toGo}k to go</span>
        </div>
        <div
          class="ruler"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax={goal.target}
          aria-valuenow={goal.current}
          aria-valuetext={`$${goal.current}k of $${goal.target}k`}
        >
          <div class="ruler-fill" style={`width:${pct}%`}></div>
        </div>
        <ol class="ticks" aria-hidden="true">
          {ticks.map((t) => <li>{t === 0 ? '$0' : `${t}k`}</li>)}
        </ol>
      </section>

      {startHere.length > 0 && (
        <section id="start" class="split">
          <div class="split-head">
            <h2>start here</h2>
            <p>new to all this? pick the one that sounds like you.</p>
          </div>
          <ul class="rows">
            {startHere.map((s) => (
              <li>
                {hasUrl(s.href)
                  ? <a class="row" href={s.href}><span class="row-title">{s.prompt}</span><span class="row-note">{s.label}</span></a>
                  : <div class="row soon"><span class="row-title">{s.prompt}</span><span class="row-note">{s.label}</span><span class="row-flag">coming soon</span></div>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {aboutPhotos.length > 0 ? (
        <section id="about" class="about">
          <div class="about-text">
            <h2>about me</h2>
            {aboutText.map((t) => <p>{t}</p>)}
          </div>
          <div class="about-photos">
            {aboutPhotos.map((ph) => <img class:list={{ wide: ph.wide }} src={ph.src} alt={ph.alt} loading="lazy" />)}
          </div>
        </section>
      ) : (
        <section id="about" class="split">
          <div class="split-head"><h2>about me</h2></div>
          <div class="about-text">
            {aboutText.map((t) => <p>{t}</p>)}
          </div>
        </section>
      )}

      {shownResources.length > 0 && (
      <section id="resources" class="split">
        <div class="split-head">
          <h2>what i actually use</h2>
          <p>the accounts and apps behind my numbers. if a link pays me anything, it says so.</p>
        </div>
        <div class="groups">
          {shownResources.map((g) => (
            <div class="group">
              <h3>{g.group}</h3>
              <ul class="rows">
                {g.items.map((r) => (
                  <li>
                    {hasUrl(r.href)
                      ? <a class="row" href={r.href}>
                          <span class="row-title">{r.name}</span>
                          {r.why && <span class="row-note">{r.why}</span>}
                          {r.affiliate && <span class="row-flag">affiliate link</span>}
                        </a>
                      : <div class="row soon">
                          <span class="row-title">{r.name}</span>
                          {r.why && <span class="row-note">{r.why}</span>}
                          <span class="row-flag">link coming soon</span>
                        </div>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
      )}

      <section class="topics">
        <h2>what i post about</h2>
        <ul>
          {topics.map((t) => <li>{t}</li>)}
        </ul>
      </section>

      <footer class="seen">
        <span class="seen-label">as seen on</span>
        <span class="seen-name">CNBC</span>
        <span class="seen-name">Acorns</span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --cream: #F6F1EE;
    --ink: #141414;
    --body: #3A372F;
    --muted: #6B6455;
    --divider: #E3DCCD;
    --kicker: #8A8172;
    --peach: #F2DBBC;
    --mint: #CFE3E1;

    --display: 'PT Serif', Georgia, serif;
    --sans: 'Inter', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--cream);
    color: var(--body);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.55;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--ink); }
  a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 4px; }
  h1, h2 { font-family: var(--display); font-weight: 400; color: var(--ink); margin: 0; }
  ul, ol { list-style: none; margin: 0; padding: 0; }

  .page { max-width: 1160px; margin: 0 auto; padding: 20px 16px 48px; display: flex; flex-direction: column; gap: 56px; }

  /* top bar */
  .top { display: flex; align-items: center; justify-content: space-between; }
  .kicker { font-size: 15px; font-weight: 500; color: var(--kicker); letter-spacing: 0.02em; }
  .top nav { display: flex; gap: 20px; font-size: 15px; font-weight: 500; }
  .top a { text-decoration: none; min-height: 44px; display: flex; align-items: center; }
  .top a:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* hero */
  .hero { display: flex; flex-direction: column; gap: 28px; margin-top: -32px; }
  .hero-photo { width: 100%; height: 360px; object-fit: cover; object-position: 50% 22%; border-radius: 14px; display: block; }
  .hero-text { display: flex; flex-direction: column; gap: 16px; }
  .hero h1 { font-size: 44px; line-height: 1.02; letter-spacing: -0.02em; }
  .hero p { margin: 0; max-width: 34ch; color: var(--muted); }

  /* links: a list, not a stack of pills */
  .links { margin-top: 12px; border-top: 1px solid var(--divider); }
  .links li { border-bottom: 1px solid var(--divider); }
  .link {
    display: flex; align-items: center; min-height: 60px; padding: 0 4px;
    text-decoration: none; font-size: 18px; font-weight: 500;
  }
  a.link:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .link.primary {
    background: var(--ink); color: var(--cream); border-radius: 10px;
    padding: 0 20px; margin: 10px 0;
  }
  .link.primary:hover { text-decoration: none; background: var(--body); }
  .link.primary:focus-visible { outline-offset: 2px; }
  .link.soon { justify-content: space-between; gap: 16px; color: var(--muted); }
  .soon-note { font-size: 14px; font-weight: 400; color: var(--kicker); white-space: nowrap; }

  /* goal ruler: the one loud element */
  .goal { display: flex; flex-direction: column; gap: 10px; padding-top: 24px; border-top: 1px solid var(--ink); }
  .goal-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .goal h2 { font-size: 24px; }
  .goal-date { font-size: 15px; color: var(--muted); }
  .goal-figures { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .goal-now { font-family: var(--display); color: var(--ink); font-size: 76px; line-height: 1; letter-spacing: -0.03em; }
  .goal-left { font-size: 16px; font-weight: 500; color: var(--body); white-space: nowrap; }
  .ruler {
    position: relative; height: 36px; margin-top: 8px;
    border: 1.5px solid var(--ink); border-radius: 6px; overflow: hidden;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(100% / 6 - 1px), var(--divider) calc(100% / 6 - 1px) calc(100% / 6));
  }
  .ruler-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--peach), var(--mint));
    border-right: 1.5px solid var(--ink);
  }
  .ticks { display: flex; justify-content: space-between; font-size: 13px; color: var(--kicker); }

  /* about */
  .about { display: flex; flex-direction: column; gap: 24px; }
  .about h2, .topics h2 { font-size: 34px; line-height: 1.05; letter-spacing: -0.01em; }
  .about-text { display: flex; flex-direction: column; gap: 16px; }
  .about-text p { margin: 0; max-width: 60ch; line-height: 1.65; }
  .about-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .about-photos img { width: 100%; height: 190px; object-fit: cover; border-radius: 12px; display: block; }
  .about-photos img.wide { grid-column: span 2; }

  /* start here + resources: heading beside divided rows */
  .split { display: flex; flex-direction: column; gap: 20px; }
  .split h2 { font-size: 34px; line-height: 1.05; letter-spacing: -0.01em; }
  .split-head { display: flex; flex-direction: column; gap: 12px; }
  .split-head p { margin: 0; max-width: 36ch; color: var(--muted); }
  .groups { display: flex; flex-direction: column; gap: 28px; }
  .group h3 { margin: 0 0 8px; font-size: 15px; font-weight: 500; color: var(--kicker); }
  .rows { border-top: 1px solid var(--divider); }
  .rows li { border-bottom: 1px solid var(--divider); }
  .row { display: flex; flex-direction: column; gap: 2px; padding: 14px 4px; text-decoration: none; }
  .row-title { font-size: 18px; font-weight: 500; color: var(--ink); }
  a.row:hover .row-title { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .row-note { font-size: 15px; color: var(--muted); }
  .row-flag { font-size: 13px; color: var(--kicker); }
  .row.soon .row-title { color: var(--body); }

  /* topics */
  .topics { display: flex; flex-direction: column; gap: 16px; }
  .topics ul { border-top: 1px solid var(--divider); }
  .topics li { padding: 14px 4px; border-bottom: 1px solid var(--divider); font-size: 18px; color: var(--ink); }

  /* footer */
  .seen { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 24px; padding-top: 24px; border-top: 1px solid var(--divider); }
  .seen-label { width: 100%; font-size: 15px; color: var(--kicker); }
  .seen-name { font-family: var(--display); font-size: 24px; color: var(--ink); }

  @media (min-width: 900px) {
    .page { padding: 32px 48px 64px; gap: 96px; }

    .hero {
      display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: 72px; align-items: end; margin-top: -24px;
    }
    .hero-photo { height: 640px; border-radius: 18px; }
    .hero-text { gap: 20px; padding-bottom: 8px; }
    .hero h1 { font-size: 80px; line-height: 0.98; }
    .hero p { font-size: 19px; }
    .links { margin-top: 20px; }

    .goal { gap: 12px; padding-top: 32px; }
    .goal h2 { font-size: 30px; }
    .goal-date, .goal-left { font-size: 18px; }
    .goal-now { font-size: 168px; line-height: 0.9; }
    .ruler { height: 56px; border-radius: 8px; }
    .ticks { font-size: 14px; }

    .about { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 72px; align-items: start; }
    .about h2 { font-size: 56px; }
    .about-text { gap: 20px; }
    .about-text p { font-size: 18px; }
    .about-photos { gap: 14px; }
    .about-photos img { height: 280px; border-radius: 16px; }
    .about-photos img.wide { height: 220px; }

    .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 72px; align-items: start; }
    .split h2 { font-size: 56px; }
    .split-head p { font-size: 18px; }
    .groups { gap: 36px; }

    .topics { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 72px; align-items: start; }
    .topics h2 { font-size: 40px; }

    .seen { flex-wrap: nowrap; gap: 28px; }
    .seen-label { width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>
